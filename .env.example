# =============================================================================
# Application
# =============================================================================
APP_ENV=development
APP_NAME=PMAA Web
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Long tasks are dispatched to the ARQ worker so page navigation never interrupts them.
TASK_EXECUTION_MODE=arq
REDIS_EVENT_STREAM_MAXLEN=2000
REDIS_PUBLISH_TIMEOUT_SECONDS=0.3

# =============================================================================
# PostgreSQL / Redis
# =============================================================================
DATABASE_URL=postgresql+asyncpg://pmaa:pmaa@127.0.0.1:5432/pmaa
REDIS_URL=redis://127.0.0.1:6379/0

# =============================================================================
# LLM
# =============================================================================
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
DEEPSEEK_API_KEY=

# =============================================================================
# Embedding
# fastembed: local CPU ONNX model, no API key required.
# openai_compatible: remote /embeddings API.
# disabled: BM25 lexical retrieval only.
# BAAI/bge-small-zh-v1.5 outputs 512-dimensional Chinese vectors.
# =============================================================================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=64
FASTEMBED_CACHE_DIR=.cache/fastembed
FASTEMBED_THREADS=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Optional proxy used only by Docker containers.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,postgres,redis,qdrant,minio

# =============================================================================
# Web search
# =============================================================================
WEB_SEARCH_PROVIDER=disabled
TAVILY_BASE_URL=https://api.tavily.com/search
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
AGENT_RUNTIME_MAX_CONCURRENCY=4
WEB_RESEARCH_MAX_ROUNDS=2
WEB_RESEARCH_MAX_QUERIES=3

# =============================================================================
# QQ Mail (reserved until the Email Agent is migrated)
# =============================================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=qq
QQ_EMAIL_ADDRESS=
QQ_EMAIL_AUTH_CODE=
QQ_IMAP_HOST=imap.qq.com
QQ_IMAP_PORT=993
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
EMAIL_POLL_INTERVAL_SECONDS=300

# =============================================================================
# GitHub monitor and scheduler (reserved)
# =============================================================================
GITHUB_MONITOR_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_POLL_INTERVAL_SECONDS=60

# =============================================================================
# Feishu Calendar (reserved until the Calendar Agent is migrated)
# =============================================================================
FEISHU_CALENDAR_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/feishu/callback
FEISHU_OAUTH_STATE_TTL_SECONDS=600
# Generate a Fernet key before enabling token persistence.
FEISHU_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Authentication
# =============================================================================
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# =============================================================================
# Qdrant / MinIO / Agentic RAG
# =============================================================================
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=pmaa_documents

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=pmaa
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=pmaa-documents

MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
